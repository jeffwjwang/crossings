# Copy to .env.local. Do not commit real values.
# The sample app does not need any of these.

# Bearer token for /api/admin. Leave empty until you are ready to publish puzzles.
ADMIN_API_TOKEN=

# HTTP basic auth for the /admin page. Leave empty and the page stays closed.
ADMIN_USER=
ADMIN_PASSWORD=

# Neon connection string. Not used by this skeleton.
DATABASE_URL=
